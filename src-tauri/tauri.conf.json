{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H.I.D.E",
  "version": "1.3.2",
  "identifier": "com.nexus.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "H.I.D.E",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMjgyMzQ3NzYxMUQxNEMKUldSTTBSRjJSeU1vUFQ4UVpQajlpKzNjNFh3aG0vTDJSWndTREhNRko1NkM3UStObmkzaUNIeGYK",
      "endpoints": [
        "https://github.com/misakimiku2/H.E.I.D-Editor/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "headerImage": "./icons/installer-header.bmp",
        "sidebarImage": "./icons/installer-sidebar.bmp",
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "txt", "log", "md", "markdown",
          "json", "yaml", "yml", "toml", "ini", "xml", "svg",
          "ts", "tsx", "js", "jsx", "py", "rs", "go", "java",
          "c", "cpp", "cc", "cxx", "h", "hpp", "cs", "rb", "php",
          "html", "htm", "css", "scss", "less",
          "sh", "bash", "sql", "swift", "kt", "kts", "scala", "vue", "svelte"
        ],
        "name": "H.I.D.E Document",
        "description": "文本与代码文档（H.I.D.E 编辑器）",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}