    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.5 设备互联阶段 1：应用内「扫一扫」配对本机 WebView 的 getUserMedia 需要 CAMERA。
         生成的 RustWebChromeClient.onPermissionRequest 会据此在运行时申请 CAMERA 并 grant/deny，
         不需要新写 Kotlin 桥；但权限必须在这里声明，否则走 else 分支虽 grant、系统层仍拒 → NotReadableError。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false：无相机的设备（或相机被禁用）也能装，只是扫码降级为粘贴/短码 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

