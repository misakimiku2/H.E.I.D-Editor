{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H.I.D.E",
  "version": "1.6.1",
  "identifier": "com.nexus.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "H.I.D.E",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMjgyMzQ3NzYxMUQxNEMKUldSTTBSRjJSeU1vUFQ4UVpQajlpKzNjNFh3aG0vTDJSWndTREhNRko1NkM3UStObmkzaUNIeGYK",
      "endpoints": [
        "https://github.com/misakimiku2/H.E.I.D-Editor/releases/latest/download/latest.json",
        "https://gitee.com/misakimiku2/heid-editor/releases/download/mirror-latest/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "headerImage": "./icons/installer-header.bmp",
        "sidebarImage": "./icons/installer-sidebar.bmp",
        "installerHooks": "./nsis/installer-hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["txt"],
        "name": "com.nexus.editor.txt",
        "description": "H.I.D.E 文本文档",
        "role": "Editor"
      },
      {
        "ext": ["log"],
        "name": "com.nexus.editor.log",
        "description": "H.I.D.E 日志文件",
        "role": "Editor"
      },
      {
        "ext": ["md", "markdown"],
        "name": "com.nexus.editor.md",
        "description": "H.I.D.E Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": ["json"],
        "name": "com.nexus.editor.json",
        "description": "H.I.D.E JSON 文档",
        "role": "Editor"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "com.nexus.editor.yaml",
        "description": "H.I.D.E YAML 文档",
        "role": "Editor"
      },
      {
        "ext": ["toml"],
        "name": "com.nexus.editor.toml",
        "description": "H.I.D.E TOML 配置",
        "role": "Editor"
      },
      {
        "ext": ["ini"],
        "name": "com.nexus.editor.ini",
        "description": "H.I.D.E INI 配置",
        "role": "Editor"
      },
      {
        "ext": ["xml"],
        "name": "com.nexus.editor.xml",
        "description": "H.I.D.E XML 文档",
        "role": "Editor"
      },
      {
        "ext": ["svg"],
        "name": "com.nexus.editor.svg",
        "description": "H.I.D.E SVG 矢量图",
        "role": "Editor"
      },
      {
        "ext": ["ts", "tsx"],
        "name": "com.nexus.editor.ts",
        "description": "H.I.D.E TypeScript 源码",
        "role": "Editor"
      },
      {
