{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口与拖出子窗口权限（全平台）：文件读写、系统对话框与多窗口标签传输",
  "windows": ["main", "win-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-ask",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-http-get",
    "allow-http-get-binary",
    "allow-open-external",
    "allow-render-page",
    "allow-take-launch-paths",
    "allow-probe-large-file",
    "allow-read-line-window",
    "allow-read-byte-window",
    "allow-file-size",
    "allow-create-document-window",
    "allow-take-window-bootstrap",
    "allow-window-under-cursor",
    "allow-send-to-window",
    "allow-window-count",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "**" }]
    },
    "fs:allow-unwatch",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-read-image",
    "clipboard-manager:allow-write-text",
    "allow-fs-mkdir",
    "allow-fs-rename",
    "allow-fs-copy",
    "allow-fs-delete",
    "allow-fs-reveal",
    "allow-search-in-dir"
  ]
}
